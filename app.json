{
  "expo": {
    "name": "RescueLink",
    "slug": "rescuelink",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rescuelink.app"
    },
    "android": {
      "package": "com.rescuelink.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RescueLink uses your location when you tap Current location to fill your pickup address."
        }
      ],
      "expo-font"
    ]
  }
}
